;; Babashka runner for the net.b12n.raygui-jlt raygui examples.
;;
;;   bb lib:build       compile vendor/raygui.h -> lib/libraygui.dylib
;;   bb lib:check       is raylib installed? is libraygui built?
;;   bb check           headless compile-check of every example
;;   bb check:registration  source, deps.edn alias and check.clj require
;;   bb aot             build one example as a native binary and run it
;;                      (needs a display; see the task's own comment)
;;
;; Quality: bb lint | lint:strict, bb lsp:format | lsp:format-check,
;; bb lsp:clean-ns | lsp:clean-ns-check, bb lsp:diagnostics, bb lsp:check
;; (all three, dry run), bb lsp:fix (format + clean-ns, mutating),
;; bb check:positional-args | :strict (find fns with 3+ positional args).
;; Git hooks: bb hooks:install (fast) | hooks:install:full (+ bb check) |
;; hooks:uninstall.
;;
;; NOTE: task bodies are read by babashka's EDN reader, which does NOT support
;; #"regex", @deref, or #(...) reader macros — use (re-pattern "..."),
;; (deref ...) and (fn [x] ...). Run `bb tasks` after editing to confirm the
;; file still parses.
{:min-bb-version "1.3.0"
 :paths ["scripts"]

 :tasks
 {:init
  (do
    (require '[babashka.fs :as fs]
             '[clojure.string :as str])

    (def repo-root (str (fs/parent (fs/absolutize "bb.edn"))))

    ;; --- documentation site -------------------------------------------------
    ;; The generator lives in jlt-commons/docs-engine, not here. The site is
    ;; built in CI (.github/workflows/site.yml, which pins an engine tag), so
    ;; these tasks exist only for local preview and are the one place that
    ;; needs a checkout of the engine on disk.
    (def docs-engine-repo "https://github.com/jlt-commons/docs-engine")

    (defn docs-engine-dir
      "Where the engine is checked out: $JLT_DOCS_ENGINE, else a sibling
       directory, else the usual spot. nil when none of them exist."
      []
      (let [home (System/getProperty "user.home")]
        (->> [(System/getenv "JLT_DOCS_ENGINE")
              "../docs-engine"
              (str home "/dev/jlt-commons/docs-engine")]
             (remove nil?)
             (filter (fn [d] (fs/exists? (fs/file d "bb.edn"))))
             first)))

    (defn site-task
      "Runs one of the engine's tasks against this project."
      [task & args]
      (if-let [engine (docs-engine-dir)]
        (let [argv (into ["bb" task repo-root] (remove nil? args))
              res  (apply shell {:dir (str engine) :continue true} argv)]
          (when-not (zero? (:exit res)) (System/exit (:exit res))))
        (do
          (println "The docs engine is not checked out anywhere I looked:")
          (println "  $JLT_DOCS_ENGINE, ../docs-engine, ~/dev/jlt-commons/docs-engine")
          (println)
          (println "  git clone" docs-engine-repo "../docs-engine")
          (println)
          (println "CI does not need this — it checks the engine out itself.")
          (System/exit 1))))

    (defn mac? [] (str/starts-with? (System/getProperty "os.name") "Mac"))

    (def lib-path
      (str repo-root "/lib/libraygui." (if (mac?) "dylib" "so")))

    (defn lib-built? [] (fs/exists? lib-path))

    ;; Homebrew's include/lib dirs are not on the compiler's default search
    ;; path, so they are named explicitly. Linux uses the distro's default
    ;; paths plus whatever pkg-config would report. Exercised on every push
    ;; by the Linux job in .github/workflows/ci.yml.
    (defn build-argv
      []
      (if (mac?)
        ["cc" "-O2" "-dynamiclib" "-fPIC" "-DBUILD_LIBTYPE_SHARED"
         "-I" (str repo-root "/vendor")
         "-I" "/opt/homebrew/include"
         "-L" "/opt/homebrew/lib" "-lraylib"
         "-framework" "CoreVideo" "-framework" "IOKit"
         "-framework" "Cocoa" "-framework" "OpenGL"
         "-o" lib-path (str repo-root "/vendor/raygui_impl.c")]
        ;; The -l flags MUST come after the translation unit that needs them.
        ;; GNU ld resolves left to right and Ubuntu defaults to --as-needed, so
        ;; a -lraylib placed before raygui_impl.c records no DT_NEEDED: the .so
        ;; links cleanly, exports all 61 Gui* symbols, and has raylib's symbols
        ;; undefined with nothing saying where to find them. jolt then reports
        ;; it as "required native library raygui not found", which points at the
        ;; wrong thing entirely. macOS's linker is order-insensitive, which is
        ;; why the mac argv above tolerates either order and this one does not.
        ;; Verified in an ubuntu:24.04 container: with the old order
        ;; `ldd libraygui.so | grep raylib` was empty and `bb check` failed.
        ["cc" "-O2" "-shared" "-fPIC" "-DBUILD_LIBTYPE_SHARED"
         "-I" (str repo-root "/vendor")
         "-o" lib-path (str repo-root "/vendor/raygui_impl.c")
         "-lraylib" "-lGL" "-lm" "-lpthread" "-ldl" "-lrt" "-lX11"]))

    (defn build-lib!
      []
      (fs/create-dirs (str repo-root "/lib"))
      (println (str "Compiling vendor/raygui_impl.c -> " lib-path))
      (let [{:keys [exit]} (apply shell {:continue true} (build-argv))]
        (if (zero? exit)
          (println (str "OK  " lib-path))
          (do (binding [*out* *err*]
                (println "")
                (println "libraygui build FAILED.")
                (println "Most likely cause: raylib's headers are not where the")
                (println "compiler looked.")
                (if (mac?)
                  (do
                    (println "Check `brew list --versions raylib`, and if it is")
                    (println "installed but the build still cannot find raylib.h,")
                    (println "try `brew link raylib`."))
                  (do
                      ;; Ubuntu has no libraylib-dev at all, verified against
                      ;; 24.04 with universe enabled: the only match is
                      ;; python3-xraylib, an unrelated X-ray physics library.
                      ;; So on Linux the normal fix is a source build, and the
                      ;; brew advice above would send someone the wrong way.
                      (println "There is no libraylib-dev package on Ubuntu, so a")
                      (println "source build is the normal path:")
                      (println "  https://github.com/raysan5/raylib   cmake -DBUILD_SHARED_LIBS=ON")
                      (println "Then run `sudo ldconfig` so the linker sees libraylib.so."))))
              (System/exit 1)))))

    (defn ensure-lib!
      "Build the native library if it is missing, so a fresh clone can run an
       example without a separate setup step."
      []
      (when-not (lib-built?) (build-lib!)))

    (require '[examples-registry :as reg])
    (require '[readme-table :as rt])
    (require '[registration :as regi])

    (def by-name
      (into {} (map (fn [r] [(nth r 0) r]) reg/examples)))

    (defn run-example
      [name]
      (let [row (get by-name name)]
        (if row
          (do (ensure-lib!)
              (println (str "▶ " name))
              (shell "jolt" (str "-M:" (nth row 1))))
          (do (binding [*out* *err*]
                (println (str "Unknown example: " (pr-str name)))
                (println "Run `bb examples` to see the list."))
              (System/exit 1)))))

    (def kondo-dep
      "{:deps {clj-kondo/clj-kondo {:mvn/version \"2025.02.20\"}}}")

    (defn kondo-argv
      "Prefer the native binary when installed; fall back to the clojure CLI so a
       bare checkout still lints."
      []
      (if (fs/which "clj-kondo")
        ["clj-kondo"]
        ["clojure" "-Sdeps" kondo-dep "-M" "-m" "clj-kondo.main"])))

  lib:build
  {:doc "Compile vendor/raygui.h into lib/libraygui.{dylib,so}"
   :task (build-lib!)}

  lib:check
  {:doc "Is raylib installed? Is libraygui built? (read-only)"
   :task
   (let [rl (some (fn [p] (when (fs/exists? p) p))
                  ["/opt/homebrew/lib/libraylib.dylib"
                   "/usr/local/lib/libraylib.dylib"
                   "/usr/lib/libraylib.so"
                   "/usr/local/lib/libraylib.so"])]
     (println (str "raylib   " (if rl (str "found: " rl) "NOT FOUND")))
     (when-not rl
       (println "         install it: brew install raylib  (macOS)"))
     (println (str "libraygui " (if (lib-built?)
                                  (str "built: " lib-path)
                                  "not built")))
     (when-not (lib-built?)
       (println "         build it: bb lib:build"))
     (when (and rl (lib-built?))
       (println "")
       (println "Both present. `bb check` will compile the suite.")))}

  test
  {:doc "Unit suite: ffi/write argument order"
   :task (shell "jolt" "-M:test")}

  check
  {:doc "Headless compile-check of every example (no window)"
   :task (do (ensure-lib!) (shell "jolt" "-M:check"))}

  check:registration
  {:doc "Source, deps.edn alias and check.clj require agree with the registry"
   ;; The gate `check` cannot be for itself, and touchpoint 3 is why.
   ;;
   ;; `bb check` compiles what check.clj requires. An example left out of that
   ;; list is never compiled, and the run still prints "all example namespaces
   ;; compiled OK" and exits 0. Measured 2026-08-29: a namespace carrying a
   ;; deliberate unresolved symbol fails `bb check` with its require present,
   ;; and passes with the require removed. So the compile gate goes green over
   ;; code it never read, which is the failure this task exists to catch.
   ;;
   ;; Needs no jolt, no raylib and no libraygui, so it runs anywhere and in
   ;; well under a second.
   :task
   (let [probs (regi/problems repo-root reg/examples)]
     (if (seq probs)
       (binding [*out* *err*]
         (println "registration gaps:")
         (doseq [[n what] probs] (println (str "  " n ": " what)))
         (System/exit 1))
       (println (str "registration ok, " (count reg/examples)
                     " examples across source, deps.edn alias and check.clj"))))}

  aot
  {:doc "Build one example as a native binary and RUN it -- the AOT gate"
   ;; Everything else here runs under `jolt run`, which cannot see a bug that
   ;; exists only in a built image. jolt#757 was exactly that: jolt.ffi's own
   ;; defns were interned but UNBOUND in a `jolt build` image while `jolt run`
   ;; compiled them from source and worked. Fixed by jolt#756.
   ;;
   ;; This repo sits directly on that surface, which is why the gate is worth
   ;; more here than in the sibling projects. raygui.clj calls `ffi/layout-size`
   ;; inside two top-level `def`s, so an affected jolt would fail at namespace
   ;; load rather than at some rarely-taken branch, and `rect->` writes all four
   ;; Rectangle fields with `ffi/write-field` on the path every Gui* control
   ;; takes. basic-controls is built rather than the headless `check` entry
   ;; point for that reason: `check` only requires namespaces, so it would
   ;; never call the accessors and would pass while broken.
   ;;
   ;; It runs from the REPO ROOT, not a temp directory. deps.edn declares
   ;; raygui at the repo-relative `lib/libraygui.dylib`, so a built binary is
   ;; not relocatable -- moving it elsewhere fails with
   ;; `required native library not found ("lib/libraygui.dylib")` and exit 255.
   ;; Verified, 2026-08-28. Do not "fix" this into a temp dir without first
   ;; making that path absolute.
   ;;
   ;; NOT wired into `bb check` and NOT in ci.yml, both on purpose. `bb check`
   ;; promises to be headless and CI runs it with no display, while this opens
   ;; a real window. CI also pins JOLT_VERSION v0.7.25, which predates the
   ;; jolt#756 fix and has not been tested for this.
   :task
   (do
     (ensure-lib!)
     (let [ex  "basic-controls"
           bin (str (fs/path (fs/create-temp-dir) "raygui-jlt-aot"))]
       (println (str "  building " ex))
       (shell "jolt" "build" "-m" (str "net.b12n.raygui-jlt." ex) "-o" bin)
       (println (str "\n  running it for 800ms from " repo-root))
       (shell {:dir repo-root :extra-env {"RAYGUI_APP_AUTO_QUIT_MS" "800"}} bin)
       (println "\naot: the native binary built and ran")))}

  examples
  {:doc "Flat list of every example with its description"
   :task
   (let [w (reg/max-name-width)
         over (reg/check-descriptions)
         drift (reg/doc-mismatches)]
     (doseq [row reg/examples]
       (println (str "  " (reg/pad (nth row 0) w) "  " (nth row 3))))
     (println "")
     (println (str "  " (count reg/examples) " examples"))
     (when (seq over)
       (binding [*out* *err*]
         (println "")
         (println "Descriptions over the 49-character cap:")
         (doseq [[n len] over] (println (str "  " n " (" len ")")))
         (System/exit 1)))
     (when (seq drift)
       (binding [*out* *err*]
         (println "")
         (println "bb.edn :doc disagrees with the registry description:")
         (doseq [[n expected actual] drift]
           (println (str "  " n))
           (println (str "    registry: " expected))
           (println (str "    bb.edn:   " (if actual actual "(no task!)"))))
         (System/exit 1))))}

  info
  {:doc "Grouped cheat-sheet"
   :task
   (let [w (reg/max-name-width)
         grouped (reg/by-group)]
     (doseq [g reg/groups]
       (when (seq (get grouped g))
         (println (str "\n" g))
         (doseq [row (get grouped g)]
           (println (str "  bb " (reg/pad (nth row 0) w) "  " (nth row 3)))))))}

  readme:examples
  {:doc "Regenerate the README example gallery from the registry"
   :task
   (do
     (let [missing (rt/missing-demos repo-root)]
       (when (seq missing)
         (binding [*out* *err*]
           (println "\u2717 missing screenshots:")
           (doseq [row missing] (println (str "    " (rt/demo-path (nth row 0))))))
         (System/exit 1)))
     (let [path    (str repo-root "/README.md")
           text    (slurp path)
           spliced (rt/splice text (rt/html))]
       (if spliced
         (do (spit path spliced)
             (println (str "\u2713 README gallery regenerated ("
                           (count reg/examples) " examples)")))
         (do (binding [*out* *err*]
               (println "\u2717 README markers not found. Expected both of:")
               (println (str "    " rt/begin-marker))
               (println (str "    " rt/end-marker)))
             (System/exit 1)))))}

  readme:examples-check
  {:doc "Fail if the README gallery is stale or an example lacks a screenshot"
   :task
   (do
     (let [missing (rt/missing-demos repo-root)
           path    (str repo-root "/README.md")
           text    (slurp path)
           spliced (rt/splice text (rt/html))]
       (cond
         (seq missing)
         (do (binding [*out* *err*]
               (println "\u2717 missing screenshots:")
               (doseq [row missing] (println (str "    " (rt/demo-path (nth row 0))))))
             (System/exit 1))

         (nil? spliced)
         (do (binding [*out* *err*] (println "\u2717 README markers not found"))
             (System/exit 1))

         (not= spliced text)
         (do (binding [*out* *err*]
               (println "\u2717 README gallery is stale - run bb readme:examples"))
             (System/exit 1))

         :else (println "\u2713 README gallery matches the registry"))))}

  site:build
  {:doc "Build the documentation site into _site/ (needs a docs-engine checkout)"
   :task (site-task "build")}

  site:serve
  {:doc "Build the docs site and serve it at http://localhost:3000 (bb site:serve [port])"
   :task (site-task "serve" (first *command-line-args*))}

  site:clean
  {:doc "Delete the _site/ build output"
   :task (site-task "clean")}

  basic-controls
  {:doc "▶ button, label and a live click counter"
   :task (run-example "basic-controls")}

  icon-buttons
  {:doc "▶ the embedded 1-bit icon pack on buttons"
   :task (run-example "icon-buttons")}

  labels-lines
  {:doc "▶ labels, separators and a status bar"
   :task (run-example "labels-lines")}

  toggles
  {:doc "▶ toggle, toggle group and toggle slider"
   :task (run-example "toggles")}

  text-box
  {:doc "▶ an editable text box with edit mode"
   :task (run-example "text-box")}

  text-input-box
  {:doc "▶ a modal text prompt with secret toggle"
   :task (run-example "text-input-box")}

  spinner-value-box
  {:doc "▶ spinner and value box, clamped and typed"
   :task (run-example "spinner-value-box")}

  sliders
  {:doc "▶ slider, slider bar and their value cells"
   :task (run-example "sliders")}

  progress-bar
  {:doc "▶ a progress bar driven by a timer"
   :task (run-example "progress-bar")}

  dropdown-box
  {:doc "▶ a dropdown that owns its edit mode"
   :task (run-example "dropdown-box")}

  combo-box
  {:doc "▶ a combo box cycling through options"
   :task (run-example "combo-box")}

  list-view
  {:doc "▶ a scrollable list with an active row"
   :task (run-example "list-view")}

  list-view-ex
  {:doc "▶ a list view reporting focus and scroll"
   :task (run-example "list-view-ex")}

  tab-bar
  {:doc "▶ tabs with close requests"
   :task (run-example "tab-bar")}

  panel-group-box
  {:doc "▶ panels and group boxes as containers"
   :task (run-example "panel-group-box")}

  scroll-panel
  {:doc "▶ a scroll panel over oversized content"
   :task (run-example "scroll-panel")}

  window-box
  {:doc "▶ a window box you can close and reopen"
   :task (run-example "window-box")}

  floating-window
  {:doc "▶ two draggable floating windows"
   :task (run-example "floating-window")}

  message-box
  {:doc "▶ a modal message box with two buttons"
   :task (run-example "message-box")}

  custom-input-box
  {:doc "▶ a hand-built input dialog over a panel"
   :task (run-example "custom-input-box")}

  color-picker
  {:doc "▶ an RGB picker with an alpha bar"
   :task (run-example "color-picker")}

  color-picker-hsv
  {:doc "▶ the HSV picker and panel"
   :task (run-example "color-picker-hsv")}

  style-selector
  {:doc "▶ cycle six vendored .rgs style themes"
   :task (run-example "style-selector")}

  gui-state
  {:doc "▶ forced states, alpha and lock"
   :task (run-example "gui-state")}

  lint
  {:doc "clj-kondo over src + scripts (report only)"
   :task (apply shell {:continue true}
                (concat (kondo-argv) ["--lint" "src" "scripts"]))}

  lint:strict
  {:doc "bb lint, but exit non-zero if any findings"
   :task (let [{:keys [exit]} (apply shell {:continue true}
                                     (concat (kondo-argv)
                                             ["--lint" "src" "scripts"]))]
           (when-not (zero? exit) (System/exit exit)))}

  check:positional-args
  {:doc "Find fns with 3+ positional args (prefer a kwargs map; report only)"
   :task (let [{:keys [exit]} (shell {:continue true} "bb" "scripts/check_positional_args.clj")]
           (System/exit exit))}

  check:positional-args:strict
  {:doc "bb check:positional-args, but exit non-zero if any found"
   :task (let [{:keys [exit]} (shell {:continue true} "bb" "scripts/check_positional_args.clj" "--strict")]
           (System/exit exit))}

  lsp:format
  {:doc "Reformat all Clojure files (clojure-lsp)"
   :task (shell "clojure-lsp" "format")}

  lsp:format-check
  {:doc "Check formatting — dry run"
   :task (shell "clojure-lsp" "format" "--dry")}

  lsp:clean-ns
  {:doc "Clean + organize ns forms (clojure-lsp)"
   :task (shell "clojure-lsp" "clean-ns")}

  lsp:clean-ns-check
  {:doc "Check ns forms — dry run"
   :task (shell "clojure-lsp" "clean-ns" "--dry")}

  lsp:diagnostics
  {:doc "clojure-lsp diagnostics"
   :task (let [{:keys [exit]} (shell {:continue true} "clojure-lsp" "diagnostics")]
           (if (zero? exit)
             (println "OK no diagnostics")
             (println "!! diagnostics found (see above)")))}

  lsp:check
  {:doc "All LSP checks (format + clean-ns + diagnostics) — dry run"
   :task (do (println "-> LSP checks (dry run)")
             (println "-> format --dry")
             (shell {:continue true} "clojure-lsp" "format" "--dry")
             (println "-> clean-ns --dry")
             (shell {:continue true} "clojure-lsp" "clean-ns" "--dry")
             (println "-> diagnostics")
             (shell {:continue true} "clojure-lsp" "diagnostics")
             (println "OK LSP checks done (see above for any issues)"))}

  lsp:fix
  {:doc "Auto-fix: format + clean-ns (mutating)"
   :task (do (println "-> LSP auto-fix")
             (println "-> format")
             (shell {:continue true} "clojure-lsp" "format")
             (println "-> clean-ns")
             (shell {:continue true} "clojure-lsp" "clean-ns")
             (println "OK auto-fixes applied — run bb lsp:diagnostics + bb check to confirm"))}

  hooks:install
  {:doc "Install FAST pre-commit hook (lint + format + clean-ns, ~2s)"
   :task
   (let [hook ".git/hooks/pre-commit"]
     (spit hook
           (str "#!/bin/sh\n"
                "set -e\n"
                "# raygui-jlt pre-commit (FAST). Full (+ bb check): bb hooks:install:full\n"
                "bb check:registration\n"
                "bb lint:strict\n"
                "bb lsp:format-check\n"
                "bb lsp:clean-ns-check\n"))
     (fs/set-posix-file-permissions hook "rwxr-xr-x")
     (println (str "Installed " hook)))}

  hooks:install:full
  {:doc "Install FULL pre-commit hook (+ bb check, slower)"
   :task
   (let [hook ".git/hooks/pre-commit"]
     (spit hook
           (str "#!/bin/sh\n"
                "set -e\n"
                "# raygui-jlt pre-commit (FULL). Fast: bb hooks:install\n"
                "bb check:registration\n"
                "bb lint:strict\n"
                "bb lsp:format-check\n"
                "bb lsp:clean-ns-check\n"
                "bb check\n"))
     (fs/set-posix-file-permissions hook "rwxr-xr-x")
     (println (str "Installed " hook)))}

  hooks:uninstall
  {:doc "Remove the git pre-commit hook"
   :task (do (fs/delete-if-exists ".git/hooks/pre-commit")
             (println "Removed .git/hooks/pre-commit"))}}}
